  <diagram id="qHP5lENqbVgaNWr4_1-N" name="Trang-61">
    <mxGraphModel dx="3121" dy="1703" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n&#39; 1. Tai khoan va nguoi dung\n\nclass TaiKhoan {\n    - id: Long\n    - username: String\n    - password: String\n    - vaiTro: String\n    + dangNhap()\n    + doiMatKhau()\n}\n\nclass SinhVien {\n    - maSv: String\n    - idTaiKhoan: Long\n    - maChuyenNganh: String\n    - hoTen: String\n    - email: String\n    - soDienThoai: String\n    + dangKyGiangVien()\n    + dangKyThucTap()\n    + xemQuaTrinh()\n    + xemKetQua()\n}\n\nclass GiangVien {\n    - maGv: String\n    - idTaiKhoan: Long\n    - hoTen: String\n    - email: String\n    - soDienThoai: String\n    + duyetDangKyGiangVien()\n    + xetDuyetThucTap()\n    + theoDoiThucTap()\n    + danhGiaSinhVien()\n    + doiSoatDanhGia()\n    + xacNhanKetQua()\n}\n\nclass DoanhNghiep {\n    - maDn: String\n    - idTaiKhoan: Long\n    - tenDn: String\n    - diaChi: String\n    - email: String\n    - soDienThoai: String\n    + capNhatThongTin()\n    + quanLyViTri()\n    + xacNhanSinhVien()\n    + danhGiaSinhVien()\n}\n\n&#39; 2. Vi tri thuc tap va chuyen nganh\n\nclass ChuyenNganh {\n    - maChuyenNganh: String\n    - tenChuyenNganh: String\n    - moTa: String\n    + xemChuyenNganh()\n}\n\nclass ViTriThucTap {\n    - maViTri: Long\n    - maDn: String\n    - tenViTri: String\n    - moTa: String\n    - yeuCau: String\n    - soLuong: int\n    - trangThai: String\n    + themViTri()\n    + capNhatViTri()\n    + capNhatTrangThai()\n}\n\nclass ViTri_ChuyenNganh {\n    - maViTri: Long\n    - maChuyenNganh: String\n    + ganChuyenNganh()\n}\n\n&#39; 3. Dang ky giang vien va thuc tap\n\nclass DangKyGiangVien {\n    - maDangKyGv: Long\n    - maSv: String\n    - maGv: String\n    - ngayDangKy: LocalDate\n    - noiDung: String\n    - trangThai: String\n    + taoDangKy()\n    + duyetDangKy()\n    + tuChoiDangKy()\n}\n\nclass DangKyThucTap {\n    - maDangKy: Long\n    - maSv: String\n    - maGv: String\n    - maViTri: Long\n    - ngayDangKy: LocalDate\n    - noiDung: String\n    - trangThaiGv: String\n    - trangThaiDn: String\n    - trangThai: String\n    + taoDangKy()\n    + guiDangKy()\n    + capNhatTrangThai()\n}\n\n&#39; 4. Qua trinh thuc tap\n\nclass QuaTrinhThucTap {\n    - maQuaTrinh: Long\n    - maDangKy: Long\n    - ngayBatDau: LocalDate\n    - ngayKetThuc: LocalDate\n    - tienDo: String\n    - trangThai: String\n    + capNhatTienDo()\n    + xemQuaTrinh()\n}\n\nclass NhatKy {\n    - maNhatKy: Long\n    - maQuaTrinh: Long\n    - ngay: LocalDate\n    - noiDung: String\n    + taoNhatKy()\n    + capNhatNhatKy()\n    + guiNhatKy()\n}\n\nclass MinhChung {\n    - maMinhChung: Long\n    - maNhatKy: Long\n    - tenFile: String\n    - duongDan: String\n    - ngayNop: LocalDateTime\n    + taiMinhChung()\n    + xemMinhChung()\n}\n\n&#39; 5. Bao cao thuc tap\n\nclass BaoCao {\n    - maBaoCao: Long\n    - maQuaTrinh: Long\n    - tenBaoCao: String\n    - duongDan: String\n    - ngayNop: LocalDateTime\n    - trangThai: String\n    + nopBaoCao()\n    + capNhatBaoCao()\n}\n\n&#39; 6. Danh gia va doi soat\n\nclass DanhGia {\n    - maDanhGia: Long\n    - maQuaTrinh: Long\n    - maDn: String\n    - maGv: String\n    - diem: Decimal\n    - noiDung: String\n    - loaiDanhGia: String\n    - ngayDanhGia: LocalDateTime\n    + taoDanhGia()\n    + capNhatDanhGia()\n    + guiDanhGia()\n}\n\nclass DoiSoatDanhGia {\n    - maDoiSoat: Long\n    - maQuaTrinh: Long\n    - maGv: String\n    - ketQua: String\n    - nhanXet: String\n    - ngayDoiSoat: LocalDateTime\n    + kiemTraDanhGia()\n    + doiChieuDanhGia()\n}\n\n&#39; 7. Xac nhan ket qua\n\nclass KetQua {\n    - maKetQua: Long\n    - maQuaTrinh: Long\n    - maGv: String\n    - ketQua: String\n    - trangThai: String\n    - ngayXacNhan: LocalDateTime\n    + tinhKetQua()\n    + kiemTraDieuKien()\n    + xacNhanKetQua()\n}\n\n&#39; 8. Cac moi quan he\n\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; SinhVien\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; GiangVien\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; DoanhNghiep\n\nChuyenNganh \&quot;1\&quot; -- \&quot;0..*\&quot; SinhVien\n\nDoanhNghiep \&quot;1\&quot; -- \&quot;0..*\&quot; ViTriThucTap\n\nViTriThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; ViTri_ChuyenNganh\nChuyenNganh \&quot;1\&quot; -- \&quot;0..*\&quot; ViTri_ChuyenNganh\n\nSinhVien \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyGiangVien\nGiangVien \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyGiangVien\n\nSinhVien \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyThucTap\nGiangVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; DangKyThucTap\nViTriThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; DangKyThucTap\n\nDangKyThucTap \&quot;1\&quot; -- \&quot;0..1\&quot; QuaTrinhThucTap\n\nQuaTrinhThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; NhatKy\nNhatKy \&quot;1\&quot; -- \&quot;0..*\&quot; MinhChung\n\nQuaTrinhThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; BaoCao\nQuaTrinhThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; DanhGia\n\nDoanhNghiep \&quot;0..1\&quot; -- \&quot;0..*\&quot; DanhGia\nGiangVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; DanhGia\n\nQuaTrinhThucTap \&quot;1\&quot; -- \&quot;0..*\&quot; DoiSoatDanhGia\nGiangVien \&quot;1\&quot; -- \&quot;0..*\&quot; DoiSoatDanhGia\n\nQuaTrinhThucTap \&quot;1\&quot; -- \&quot;0..1\&quot; KetQua\nGiangVien \&quot;1\&quot; -- \&quot;0..*\&quot; KetQua\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nVT7Y8PiPY3gKuajK0eC-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
