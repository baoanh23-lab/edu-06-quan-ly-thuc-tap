  <diagram id="DwT7RUpI9y0oQga-WdrB" name="Trang-59">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SƠ ĐỒ LỚP CHI TIẾT - HỆ THỐNG QUẢN LÝ THỰC TẬP EDU-06\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\n\n&#39;========================\n&#39; 1. TÀI KHOẢN VÀ NGƯỜI DÙNG\n&#39;========================\n\nclass TaiKhoan {\n    +id: Long\n    +username: String\n    +password: String\n    +vaiTro: String\n    --\n    +dangNhap(): boolean\n    +doiMatKhau(): void\n}\n\nclass SinhVien {\n    +maSv: String\n    +idTaiKhoan: Long\n    +maChuyenNganh: String\n    +hoTen: String\n    +email: String\n    +soDienThoai: String\n    --\n    +dangKyGiangVien(): void\n    +dangKyThucTap(): void\n    +xemQuaTrinh(): void\n    +xemKetQua(): void\n}\n\nclass GiangVien {\n    +maGv: String\n    +idTaiKhoan: Long\n    +hoTen: String\n    +email: String\n    +soDienThoai: String\n    --\n    +duyetDangKyGiangVien(): void\n    +xetDuyetThucTap(): void\n    +theoDoiThucTap(): void\n    +danhGiaSinhVien(): void\n    +doiSoatDanhGia(): void\n    +xacNhanKetQua(): void\n}\n\nclass DoanhNghiep {\n    +maDn: String\n    +idTaiKhoan: Long\n    +tenDn: String\n    +diaChi: String\n    +email: String\n    +soDienThoai: String\n    --\n    +capNhatThongTin(): void\n    +quanLyViTri(): void\n    +xacNhanSinhVien(): void\n    +danhGiaSinhVien(): void\n}\n\nclass ChuyenNganh {\n    +maChuyenNganh: String\n    +tenChuyenNganh: String\n    +moTa: String\n    --\n    +xemChuyenNganh(): void\n}\n\n&#39;========================\n&#39; 2. VỊ TRÍ THỰC TẬP\n&#39;========================\n\nclass ViTriThucTap {\n    +maViTri: Long\n    +maDn: String\n    +tenViTri: String\n    +moTa: String\n    +yeuCau: String\n    +soLuong: Integer\n    +trangThai: String\n    --\n    +themViTri(): void\n    +capNhatViTri(): void\n    +capNhatTrangThai(): void\n}\n\nclass ViTri_ChuyenNganh {\n    +maViTri: Long\n    +maChuyenNganh: String\n    --\n    +ganChuyenNganh(): void\n}\n\n&#39;========================\n&#39; 3. ĐĂNG KÝ GIẢNG VIÊN VÀ THỰC TẬP\n&#39;========================\n\nclass DangKyGiangVien {\n    +maDangKyGv: Long\n    +maSv: String\n    +maGv: String\n    +ngayDangKy: LocalDate\n    +noiDung: String\n    +trangThai: String\n    --\n    +taoDangKy(): void\n    +duyetDangKy(): void\n    +tuChoiDangKy(): void\n}\n\nclass DangKyThucTap {\n    +maDangKy: Long\n    +maSv: String\n    +maGv: String\n    +maViTri: Long\n    +ngayDangKy: LocalDate\n    +noiDung: String\n    +trangThaiGv: String\n    +trangThaiDn: String\n    +trangThai: String\n    --\n    +taoDangKy(): void\n    +guiDangKy(): void\n    +capNhatTrangThai(): void\n}\n\n&#39;========================\n&#39; 4. QUÁ TRÌNH THỰC TẬP\n&#39;========================\n\nclass QuaTrinhThucTap {\n    +maQuaTrinh: Long\n    +maDangKy: Long\n    +ngayBatDau: LocalDate\n    +ngayKetThuc: LocalDate\n    +tienDo: String\n    +trangThai: String\n    --\n    +capNhatTienDo(): void\n    +xemQuaTrinh(): void\n}\n\nclass NhatKy {\n    +maNhatKy: Long\n    +maQuaTrinh: Long\n    +ngay: LocalDate\n    +noiDung: String\n    --\n    +taoNhatKy(): void\n    +capNhatNhatKy(): void\n    +guiNhatKy(): void\n}\n\nclass MinhChung {\n    +maMinhChung: Long\n    +maNhatKy: Long\n    +tenFile: String\n    +duongDan: String\n    +ngayNop: LocalDateTime\n    --\n    +taiMinhChung(): void\n    +xemMinhChung(): void\n}\n\n&#39;========================\n&#39; 5. BÁO CÁO THỰC TẬP\n&#39;========================\n\nclass BaoCao {\n    +maBaoCao: Long\n    +maQuaTrinh: Long\n    +tenBaoCao: String\n    +duongDan: String\n    +ngayNop: LocalDateTime\n    +trangThai: String\n    --\n    +nopBaoCao(): void\n    +capNhatBaoCao(): void\n}\n\n&#39;========================\n&#39; 6. ĐÁNH GIÁ VÀ ĐỐI SOÁT\n&#39;========================\n\nclass DanhGia {\n    +maDanhGia: Long\n    +maQuaTrinh: Long\n    +maDn: String\n    +maGv: String\n    +diem: Decimal\n    +noiDung: String\n    +loaiDanhGia: String\n    +ngayDanhGia: LocalDateTime\n    --\n    +taoDanhGia(): void\n    +capNhatDanhGia(): void\n    +guiDanhGia(): void\n}\n\nclass DoiSoatDanhGia {\n    +maDoiSoat: Long\n    +maQuaTrinh: Long\n    +maGv: String\n    +ketQua: String\n    +nhanXet: String\n    +ngayDoiSoat: LocalDateTime\n    --\n    +kiemTraDanhGia(): boolean\n    +doiChieuDanhGia(): boolean\n}\n\n&#39;========================\n&#39; 7. XÁC NHẬN KẾT QUẢ\n&#39;========================\n\nclass KetQua {\n    +maKetQua: Long\n    +maQuaTrinh: Long\n    +maGv: String\n    +ketQua: String\n    +trangThai: String\n    +ngayXacNhan: LocalDateTime\n    --\n    +tinhKetQua(): void\n    +kiemTraDieuKien(): boolean\n    +xacNhanKetQua(): void\n}\n\n&#39;========================\n&#39; 8. CÁC QUAN HỆ\n&#39;========================\n\nTaiKhoan ||--o| SinhVien\nTaiKhoan ||--o| GiangVien\nTaiKhoan ||--o| DoanhNghiep\n\nChuyenNganh ||--o{ SinhVien\n\nDoanhNghiep ||--o{ ViTriThucTap\n\nViTriThucTap ||--o{ ViTri_ChuyenNganh\nChuyenNganh ||--o{ ViTri_ChuyenNganh\n\nSinhVien ||--o{ DangKyGiangVien\nGiangVien ||--o{ DangKyGiangVien\n\nSinhVien ||--o{ DangKyThucTap\nGiangVien ||--o{ DangKyThucTap\nViTriThucTap ||--o{ DangKyThucTap\n\nDangKyThucTap ||--o| QuaTrinhThucTap\n\nQuaTrinhThucTap ||--o{ NhatKy\nNhatKy ||--o{ MinhChung\n\nQuaTrinhThucTap ||--o{ BaoCao\n\nQuaTrinhThucTap ||--o{ DanhGia\nDoanhNghiep ||--o{ DanhGia\nGiangVien ||--o{ DanhGia\n\nGiangVien ||--o{ DoiSoatDanhGia\nQuaTrinhThucTap ||--o{ DoiSoatDanhGia\n\nGiangVien ||--o{ KetQua\nQuaTrinhThucTap ||--o| KetQua\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="g7D45XqFpgGanFV2nObV-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
