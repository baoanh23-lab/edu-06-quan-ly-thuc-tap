  <diagram id="_otLVtwPgoGcsP_uEGhZ" name="Trang-60">
    <mxGraphModel dx="3121" dy="1703" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SƠ ĐỒ ERD - HỆ THỐNG QUẢN LÝ THỰC TẬP EDU-06\n\nhide methods\nskinparam linetype ortho\nskinparam shadowing false\n\n&#39;========================\n&#39; 1. TÀI KHOẢN VÀ NGƯỜI DÙNG\n&#39;========================\n\nentity TaiKhoan {\n    * id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    username : NVARCHAR\n    password : NVARCHAR\n    vai_tro : NVARCHAR\n}\n\nentity SinhVien {\n    * ma_sv : VARCHAR &lt;&lt;PK&gt;&gt;\n    --\n    id_tai_khoan : BIGINT &lt;&lt;FK&gt;&gt;\n    ma_chuyen_nganh : VARCHAR &lt;&lt;FK&gt;&gt;\n    ho_ten : NVARCHAR\n    email : VARCHAR\n    so_dien_thoai : VARCHAR\n}\n\nentity GiangVien {\n    * ma_gv : VARCHAR &lt;&lt;PK&gt;&gt;\n    --\n    id_tai_khoan : BIGINT &lt;&lt;FK&gt;&gt;\n    ho_ten : NVARCHAR\n    email : VARCHAR\n    so_dien_thoai : VARCHAR\n}\n\nentity DoanhNghiep {\n    * ma_dn : VARCHAR &lt;&lt;PK&gt;&gt;\n    --\n    id_tai_khoan : BIGINT &lt;&lt;FK&gt;&gt;\n    ten_dn : NVARCHAR\n    dia_chi : NVARCHAR\n    email : VARCHAR\n    so_dien_thoai : VARCHAR\n}\n\nentity ChuyenNganh {\n    * ma_chuyen_nganh : VARCHAR &lt;&lt;PK&gt;&gt;\n    --\n    ten_chuyen_nganh : NVARCHAR\n    mo_ta : NVARCHAR\n}\n\n&#39;========================\n&#39; 2. VỊ TRÍ THỰC TẬP\n&#39;========================\n\nentity ViTriThucTap {\n    * ma_vi_tri : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_dn : VARCHAR &lt;&lt;FK&gt;&gt;\n    ten_vi_tri : NVARCHAR\n    mo_ta : NVARCHAR\n    yeu_cau : NVARCHAR\n    so_luong : INT\n    trang_thai : NVARCHAR\n}\n\nentity ViTri_ChuyenNganh {\n    * ma_vi_tri : BIGINT &lt;&lt;PK, FK&gt;&gt;\n    * ma_chuyen_nganh : VARCHAR &lt;&lt;PK, FK&gt;&gt;\n}\n\n&#39;========================\n&#39; 3. ĐĂNG KÝ GIẢNG VIÊN VÀ THỰC TẬP\n&#39;========================\n\nentity DangKyGiangVien {\n    * ma_dang_ky_gv : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_sv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ma_gv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ngay_dang_ky : DATE\n    noi_dung : NVARCHAR\n    trang_thai : NVARCHAR\n}\n\nentity DangKyThucTap {\n    * ma_dang_ky : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_sv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ma_gv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ma_vi_tri : BIGINT &lt;&lt;FK&gt;&gt;\n    ngay_dang_ky : DATE\n    noi_dung : NVARCHAR\n    trang_thai_gv : NVARCHAR\n    trang_thai_dn : NVARCHAR\n    trang_thai : NVARCHAR\n}\n\n&#39;========================\n&#39; 4. QUÁ TRÌNH THỰC TẬP\n&#39;========================\n\nentity QuaTrinhThucTap {\n    * ma_qua_trinh : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_dang_ky : BIGINT &lt;&lt;FK, UNIQUE&gt;&gt;\n    ngay_bat_dau : DATE\n    ngay_ket_thuc : DATE\n    tien_do : NVARCHAR\n    trang_thai : NVARCHAR\n}\n\nentity NhatKy {\n    * ma_nhat_ky : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_qua_trinh : BIGINT &lt;&lt;FK&gt;&gt;\n    ngay : DATE\n    noi_dung : NVARCHAR\n}\n\nentity MinhChung {\n    * ma_minh_chung : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_nhat_ky : BIGINT &lt;&lt;FK&gt;&gt;\n    ten_file : NVARCHAR\n    duong_dan : NVARCHAR\n    ngay_nop : DATETIME2\n}\n\n&#39;========================\n&#39; 5. BÁO CÁO THỰC TẬP\n&#39;========================\n\nentity BaoCao {\n    * ma_bao_cao : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_qua_trinh : BIGINT &lt;&lt;FK&gt;&gt;\n    ten_bao_cao : NVARCHAR\n    duong_dan : NVARCHAR\n    ngay_nop : DATETIME2\n    trang_thai : NVARCHAR\n}\n\n&#39;========================\n&#39; 6. ĐÁNH GIÁ VÀ ĐỐI SOÁT\n&#39;========================\n\nentity DanhGia {\n    * ma_danh_gia : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_qua_trinh : BIGINT &lt;&lt;FK&gt;&gt;\n    ma_dn : VARCHAR &lt;&lt;FK&gt;&gt;\n    ma_gv : VARCHAR &lt;&lt;FK&gt;&gt;\n    diem : NUMERIC(4,2)\n    noi_dung : NVARCHAR\n    loai_danh_gia : NVARCHAR\n    ngay_danh_gia : DATETIME2\n}\n\nentity DoiSoatDanhGia {\n    * ma_doi_soat : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_qua_trinh : BIGINT &lt;&lt;FK&gt;&gt;\n    ma_gv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ket_qua : NVARCHAR\n    nhan_xet : NVARCHAR\n    ngay_doi_soat : DATETIME2\n}\n\n&#39;========================\n&#39; 7. XÁC NHẬN KẾT QUẢ\n&#39;========================\n\nentity KetQua {\n    * ma_ket_qua : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    ma_qua_trinh : BIGINT &lt;&lt;FK, UNIQUE&gt;&gt;\n    ma_gv : VARCHAR &lt;&lt;FK&gt;&gt;\n    ket_qua : NVARCHAR\n    trang_thai : NVARCHAR\n    ngay_xac_nhan : DATETIME2\n}\n\n&#39;========================\n&#39; 8. CÁC QUAN HỆ\n&#39;========================\n\nTaiKhoan ||--o| SinhVien\nTaiKhoan ||--o| GiangVien\nTaiKhoan ||--o| DoanhNghiep\n\nChuyenNganh |o--o{ SinhVien\n\nDoanhNghiep ||--o{ ViTriThucTap\n\nViTriThucTap ||--o{ ViTri_ChuyenNganh\nChuyenNganh ||--o{ ViTri_ChuyenNganh\n\nSinhVien ||--o{ DangKyGiangVien\nGiangVien ||--o{ DangKyGiangVien\n\nSinhVien ||--o{ DangKyThucTap\nGiangVien |o--o{ DangKyThucTap\nViTriThucTap ||--o{ DangKyThucTap\n\nDangKyThucTap ||--o| QuaTrinhThucTap\n\nQuaTrinhThucTap ||--o{ NhatKy\nNhatKy ||--o{ MinhChung\n\nQuaTrinhThucTap ||--o{ BaoCao\n\nQuaTrinhThucTap ||--o{ DanhGia\nDoanhNghiep |o--o{ DanhGia\nGiangVien |o--o{ DanhGia\n\nGiangVien ||--o{ DoiSoatDanhGia\nQuaTrinhThucTap ||--o{ DoiSoatDanhGia\n\nGiangVien ||--o{ KetQua\nQuaTrinhThucTap ||--o| KetQua\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qUdopbz2HrC-UrkE79ij-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
